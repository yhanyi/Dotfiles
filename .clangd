CompileFlags:
  Add: 
    - "-std=c++20"
    - "-Wall"
    - "-Wextra"
    - "-I/opt/homebrew/opt/llvm/include"
    - "-I/opt/homebrew/include" 
    - "-I/usr/local/include"
  
Index:
  Background: Build
  StandardLibrary: true

Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    Add: 
      - modernize*
      - performance*
      - readability*

Completion:
  AllScopes: true
